# Git ignore — AI Project Template hub v2

# OS / IDE
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets (keep .env.example)
.env
.env.*
!.env.example

# Pipeline scratch (keep folder)
.meta/pipeline/**
!.meta/pipeline/.gitkeep

# Local archive dumps (keep folder)
.archive/**
!.archive/.gitkeep

# Spoke runtime dumps under MyMeet imports (keep .gitkeep)
docs/05-communications/_imports/mymeet/**
!docs/05-communications/_imports/mymeet/.gitkeep

# Local manifest overrides
project.manifest.local.yaml
